{
  "name": "seastate",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Marine conditions HUD for Even Realities G2 smart glasses, drawn with Glyph",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "host": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "font": "node tools/build-font.mjs",
    "sim": "evenhub-simulator http://localhost:5173",
    "qr": "evenhub qr http://localhost:5173",
    "pack": "npm run build && evenhub pack app.json dist -o dist/seastate.ehpk",
    "pack:check": "evenhub pack app.json dist -o dist/seastate.ehpk -c",
    "snapshot": "node tools/snapshot.mjs",
    "test": "node tools/check.mjs"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.14",
    "@gabrielevierti/glyph": "^0.3.0"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "latest",
    "@evenrealities/evenhub-simulator": "latest",
    "playwright": "^1.50.0",
    "typescript": "^5.8.3",
    "vite": "^5.4.10"
  }
}
